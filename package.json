{
    "name": "drakko-portfolio",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "format": "prettier --write src tests *.json *.js *.ts *.html README.md",
        "format:check": "prettier --check src tests *.json *.js *.ts *.html README.md",
        "preview": "vite preview",
        "test": "node --experimental-strip-types --test tests/*.test.mjs",
        "test:interactions": "node tests/experience-interactions.mjs && node tests/app-interactions.mjs && node tests/effects-interactions.mjs"
    },
    "dependencies": {
        "@fontsource/space-grotesk": "^5.3.0",
        "@fontsource/space-mono": "^5.3.0",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@react-three/drei": "10.7.8",
        "@react-three/fiber": "9.7.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "framer-motion": "^13.1.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-icons": "^5.7.0",
        "react-router-dom": "^7.18.3",
        "tailwindcss": "^4.3.3",
        "three": "0.185.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/three": "0.185.0",
        "@vitejs/plugin-react": "^6.0.4",
        "axe-core": "^4.13.0",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "happy-dom": "^20.14.5",
        "prettier": "3.6.2",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0"
    }
}
