{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        {
            "source": "/((?!cv/|assets/|_vercel/).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/cv/adrian-rodriguez-del-rio.pdf",
            "headers": [
                {
                    "key": "Content-Disposition",
                    "value": "attachment; filename=\"Adrian-Rodriguez-del-Rio-CV.pdf\""
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}
